{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright-headless": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--headless"],
      "enabled": true
    },
    "playwright-headed": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    }
  },
  "tools": {
    "playwright-headed_*": false
  }
}
