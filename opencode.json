{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright-headless": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--headless"],
      "enabled": true
    },
    "playwright-headed": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": false
    },
    "aws": {
      "type": "local",
      "command": ["uvx", "mcp-proxy-for-aws@1.6.4", "https://aws-mcp.us-east-1.api.aws/mcp", "--metadata", "AWS_REGION=eu-north-1"],
      "enabled": true,
      "environment": {
        "AWS_PROFILE": "dpm-profile",
        "AWS_REGION": "eu-north-1"
      }
    }
  },
  "tools": {
    "playwright-headed_*": false
  }
}
