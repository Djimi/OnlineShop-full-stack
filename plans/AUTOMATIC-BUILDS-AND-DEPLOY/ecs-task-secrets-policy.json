{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:eu-north-1:799111666795:secret:onlineshop/auth/db*",
        "arn:aws:secretsmanager:eu-north-1:799111666795:secret:onlineshop/items/db*",
        "arn:aws:secretsmanager:eu-north-1:799111666795:secret:onlineshop/rds/*",
        "arn:aws:secretsmanager:eu-north-1:799111666795:secret:rds!db-*"
      ]
    }
  ]
}
