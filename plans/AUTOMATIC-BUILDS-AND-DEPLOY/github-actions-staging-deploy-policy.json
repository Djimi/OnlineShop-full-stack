{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RegisterAndInspectStagingTasks",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeClusters",
        "ecs:DescribeTaskDefinition",
        "ecs:RegisterTaskDefinition",
        "ecs:DeregisterTaskDefinition",
        "ecs:DeleteTaskDefinitions",
        "ecs:RunTask",
        "ecs:TagResource",
        "ecs:DescribeServices",
        "ecs:ListTasks",
        "ecs:DescribeTasks"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ValidateIsolatedStagingNetwork",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "UpdateStagingServicesOnly",
      "Effect": "Allow",
      "Action": "ecs:UpdateService",
      "Resource": "arn:aws:ecs:eu-north-1:799111666795:service/onlineshop-staging-cluster/onlineshop-*-staging"
    },
    {
      "Sid": "ReadStagingLoadBalancer",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DescribeLoadBalancers",
        "elasticloadbalancing:DescribeTargetGroups",
        "elasticloadbalancing:DescribeTargetHealth",
        "elasticloadbalancing:DescribeListeners"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageEphemeralStagingEntryPoint",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:CreateLoadBalancer",
        "elasticloadbalancing:CreateListener",
        "elasticloadbalancing:ModifyTargetGroupAttributes",
        "elasticloadbalancing:AddTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DeleteStagingEntryPointOnly",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DeleteLoadBalancer",
        "elasticloadbalancing:DeleteListener"
      ],
      "Resource": [
        "arn:aws:elasticloadbalancing:eu-north-1:799111666795:loadbalancer/app/onlineshop-staging-v2-alb/*",
        "arn:aws:elasticloadbalancing:eu-north-1:799111666795:listener/app/onlineshop-staging-v2-alb/*/*"
      ]
    },
    {
      "Sid": "InspectStagingDatabase",
      "Effect": "Allow",
      "Action": [
        "rds:DescribeDBInstances",
        "rds:DescribeDBSnapshots",
        "rds:DescribeDBSubnetGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ManageEphemeralStagingDatabase",
      "Effect": "Allow",
      "Action": [
        "rds:CreateDBInstance",
        "rds:ModifyDBInstance",
        "rds:DeleteDBInstance",
        "rds:CreateDBSnapshot",
        "rds:CreateTenantDatabase",
        "rds:DeleteTenantDatabase",
        "rds:AddTagsToResource"
      ],
      "Resource": [
        "arn:aws:rds:eu-north-1:799111666795:db:onlineshop-staging-postgres",
        "arn:aws:rds:eu-north-1:799111666795:snapshot:onlineshop-staging-*",
        "arn:aws:rds:eu-north-1:799111666795:subgrp:onlineshop-staging-db-subnets"
      ]
    },
    {
      "Sid": "UseStagingRdsEncryptionKey",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:DescribeKey",
        "kms:Encrypt",
        "kms:GenerateDataKey*",
        "kms:ListGrants",
        "kms:ReEncrypt*"
      ],
      "Resource": "arn:aws:kms:eu-north-1:799111666795:key/c440b468-e2c0-4bc1-b50d-935c4c2ead51",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "rds.eu-north-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "CreateStagingRdsEncryptionGrant",
      "Effect": "Allow",
      "Action": "kms:CreateGrant",
      "Resource": "arn:aws:kms:eu-north-1:799111666795:key/c440b468-e2c0-4bc1-b50d-935c4c2ead51",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "rds.eu-north-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "CreateStagingRdsManagedSecret",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:TagResource"
      ],
      "Resource": "arn:aws:secretsmanager:eu-north-1:799111666795:secret:rds!db-*"
    },
    {
      "Sid": "InspectStagingBootstrapSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:DescribeSecret",
      "Resource": [
        "arn:aws:secretsmanager:eu-north-1:799111666795:secret:onlineshop/auth/db-staging-*",
        "arn:aws:secretsmanager:eu-north-1:799111666795:secret:onlineshop/items/db-staging-*",
        "arn:aws:secretsmanager:eu-north-1:799111666795:secret:rds!db-*"
      ]
    },
    {
      "Sid": "InspectStagingSqlRunnerLogs",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*"
    },
    {
      "Sid": "StagingSqlRunnerLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:GetLogEvents",
        "logs:TagLogGroup",
        "logs:TagResource",
        "logs:Unmask"
      ],
      "Resource": [
        "arn:aws:logs:eu-north-1:799111666795:log-group:/ecs/onlineshop-staging-sql-runner",
        "arn:aws:logs:eu-north-1:799111666795:log-group:/ecs/onlineshop-staging-sql-runner:log-stream:*"
      ]
    },
    {
      "Sid": "PassExecutionRoleToEcsOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::799111666795:role/ecsTaskExecutionRole",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PassRoleToRdsOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::799111666795:role/rds-monitoring-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "rds.amazonaws.com"
        }
      }
    }
  ]
}
