{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProductionEcrRead",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchGetImage",
        "ecr:DescribeImages"
      ],
      "Resource": [
        "arn:aws:ecr:eu-north-1:799111666795:repository/onlineshop-auth",
        "arn:aws:ecr:eu-north-1:799111666795:repository/onlineshop-items",
        "arn:aws:ecr:eu-north-1:799111666795:repository/onlineshop-api-gateway"
      ]
    },
    {
      "Sid": "ProductionEcrReleaseTagMinting",
      "Effect": "Allow",
      "Action": "ecr:PutImage",
      "Resource": [
        "arn:aws:ecr:eu-north-1:799111666795:repository/onlineshop-auth",
        "arn:aws:ecr:eu-north-1:799111666795:repository/onlineshop-items",
        "arn:aws:ecr:eu-north-1:799111666795:repository/onlineshop-api-gateway"
      ]
    },
    {
      "Sid": "InspectProductionServicesAndTasks",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeServices",
        "ecs:ListTasks",
        "ecs:DescribeTasks"
      ],
      "Resource": [
        "arn:aws:ecs:eu-north-1:799111666795:cluster/onlineshop-cluster",
        "arn:aws:ecs:eu-north-1:799111666795:service/onlineshop-cluster/onlineshop-auth",
        "arn:aws:ecs:eu-north-1:799111666795:service/onlineshop-cluster/onlineshop-items",
        "arn:aws:ecs:eu-north-1:799111666795:service/onlineshop-cluster/onlineshop-api-gateway",
        "arn:aws:ecs:eu-north-1:799111666795:task/onlineshop-cluster/*"
      ]
    },
    {
      "Sid": "RegisterProductionTaskDefinitions",
      "Effect": "Allow",
      "Action": [
        "ecs:RegisterTaskDefinition",
        "ecs:DescribeTaskDefinition"
      ],
      "Resource": [
        "arn:aws:ecs:eu-north-1:799111666795:task-definition/onlineshop-auth:*",
        "arn:aws:ecs:eu-north-1:799111666795:task-definition/onlineshop-items:*",
        "arn:aws:ecs:eu-north-1:799111666795:task-definition/onlineshop-api-gateway:*"
      ]
    },
    {
      "Sid": "UpdateProductionServicesOnly",
      "Effect": "Allow",
      "Action": "ecs:UpdateService",
      "Resource": [
        "arn:aws:ecs:eu-north-1:799111666795:service/onlineshop-cluster/onlineshop-auth",
        "arn:aws:ecs:eu-north-1:799111666795:service/onlineshop-cluster/onlineshop-items",
        "arn:aws:ecs:eu-north-1:799111666795:service/onlineshop-cluster/onlineshop-api-gateway"
      ]
    },
    {
      "Sid": "PassRoleToEcsOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::799111666795:role/ecsTaskExecutionRole"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ecs-tasks.amazonaws.com"
        }
      }
    },
    {
      "Sid": "FrontendBucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::onlineshop-frontend-799111666795",
        "arn:aws:s3:::onlineshop-frontend-799111666795/*"
      ]
    },
    {
      "Sid": "CloudFrontInvalidationAndInspection",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation",
        "cloudfront:GetDistribution"
      ],
      "Resource": "arn:aws:cloudfront::799111666795:distribution/EPS8MI3FV3B7X"
    },
    {
      "Sid": "ReadOnlyElbForVerificationJourneys",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DescribeLoadBalancers",
        "elasticloadbalancing:DescribeTargetHealth"
      ],
      "Resource": [
        "arn:aws:elasticloadbalancing:eu-north-1:799111666795:loadbalancer/app/onlineshop-alb/*",
        "arn:aws:elasticloadbalancing:eu-north-1:799111666795:targetgroup/onlineshop-gateway-tg/29ba79a624079a04"
      ]
    },
    {
      "Sid": "DescribeProductionDatabaseReadOnly",
      "Effect": "Allow",
      "Action": "rds:DescribeDBInstances",
      "Resource": "arn:aws:rds:eu-north-1:799111666795:db:onlineshop-postgres-db"
    }
  ]
}
